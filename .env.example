# ─────────────────────────────────────────────────────────────
# PATRIMONIO — environment variables
# Copy to .env.local for local development, and add the same
# names in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Never prefix secrets with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# Alpaca PAPER trading keys (from app.alpaca.markets → Paper → API Keys)
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Access protection. Choose a passcode, and a long random secret
# (e.g. 40+ random characters) used to sign the login cookie.
APP_PASSCODE=
SESSION_SECRET=

# Trading safeguards (optional)
TRADING_DISABLED=false          # true = emergency stop: no orders accepted
MAX_ORDER_NOTIONAL=10000        # max estimated value of one order, in USD
MAX_ORDER_QTY=1000              # max shares in one order

# ── Later phases (leave empty until that phase) ──
# ANTHROPIC_API_KEY=            # Phase 4: AI analyst, briefings
# FINNHUB_API_KEY=              # Phase 3: earnings & economic calendar
# FMP_API_KEY=                  # Phase 2: financial statements, valuation
# FRED_API_KEY=                 # Phase 3: macroeconomic data
# NEXT_PUBLIC_SUPABASE_URL=     # Phase 1b: database & accounts
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
